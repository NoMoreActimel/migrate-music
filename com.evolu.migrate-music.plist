<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.evolu.migrate-music</string>

    <!-- runs the auto-resume matcher; it loops match batches and sleeps out
         any Spotify rate-limit/ban using the real Retry-After, until done -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/evolu/research/migrate-music/.venv/bin/python</string>
        <string>/Users/evolu/research/migrate-music/auto_match.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/evolu/research/migrate-music</string>

    <!-- start as soon as the agent is loaded (and at every login after reboot) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- restart if it crashes (non-zero exit); do NOT restart on clean finish
         (exit 0 = whole library matched) -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/evolu/research/migrate-music/data/agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/evolu/research/migrate-music/data/agent.log</string>
</dict>
</plist>
