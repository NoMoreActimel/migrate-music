# ─── Yandex Music ─────────────────────────────────────────────────────────
# OAuth token for your Yandex account. See README "Getting a Yandex token".
YANDEX_MUSIC_TOKEN=
# Catalog calls return HTTP 451 outside licensed regions (RU/BY/KZ + CIS).
# Optional proxy in such a region for the fetch step, e.g.
#   socks5://user:pass@host:1080   or   http://host:8080
YANDEX_PROXY=

# ─── Spotify ──────────────────────────────────────────────────────────────
# From https://developer.spotify.com/dashboard  (free, no payment).
# Create an app, then copy Client ID / Client Secret. In the app settings add
# the redirect URI below verbatim, and under "Users and Access" add your email.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Target playlist. We CREATE a new one with this name (set in your answers).
# To instead add into an existing playlist, put its ID/URL in EXISTING_PLAYLIST.
SPOTIFY_PLAYLIST_NAME=Yandex Liked
SPOTIFY_PLAYLIST_PUBLIC=false
SPOTIFY_EXISTING_PLAYLIST=

# ─── Model fallback (optional but enabled per your choice) ──────────────────
# Used ONLY for tracks the rules can't match. Leave key blank to disable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MODEL_FALLBACK=true
